# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.env
.env.*

# Secrets — никогда в git
secrets/
*.secret
api_keys.*
*.pem
*.key
credentials.*

# Runtime и production data — никогда в git
data/
*.wal
*.parquet
*.tmp
*.log
*.db

# PostgreSQL
*.sql.bak
pg_data/

# Node / Frontend
node_modules/
dist/
.vite/
*.local

# Тесты / coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Research artifacts (большие — в отдельном volume)
research/artifacts/
research/datasets/
research/models/

# Prometheus / Grafana runtime
prometheus_data/
grafana_data/

# Системные
*.pid

# Lock-файлы процессов (runtime), но НЕ dependency lock.
# Roadmap §4 требует фиксацию зависимостей lock-файлом, §20.1 включает
# dependency lock в release artifact — значит он обязан быть в git.
*.runtime.lock
.lock
!deploy/dependencies/**/requirements.lock
*.tar.gz
