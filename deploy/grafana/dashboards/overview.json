{
  "dashboard": {
    "title": "Bybit Chart - Overview",
    "tags": ["bybit", "overview"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Process Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "collector_process_up",
            "legendFormat": "Collector"
          },
          {
            "expr": "analytics_process_up",
            "legendFormat": "Analytics"
          },
          {
            "expr": "orderflow_process_up",
            "legendFormat": "Orderflow"
          },
          {
            "expr": "maintenance_process_up",
            "legendFormat": "Maintenance"
          },
          {
            "expr": "api_process_up",
            "legendFormat": "API"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "UP"},
              {"type": "value", "value": "0", "text": "DOWN"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Trades Ingestion Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(collector_trades_received_total[1m])",
            "legendFormat": "Trades/sec"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Trades/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Book Events Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "rate(collector_book_events_received_total[1m])",
            "legendFormat": "Book events/sec"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "rate(api_http_requests_total[1m])",
            "legendFormat": "Requests/sec"
          },
          {
            "expr": "rate(api_http_errors_total[1m])",
            "legendFormat": "Errors/sec"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "WAL Lag",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "maintenance_wal_lag_seconds",
            "legendFormat": "WAL lag"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Seconds"},
          {"format": "short"}
        ],
        "alert": {
          "name": "WAL Lag High",
          "conditions": [
            {
              "evaluator": {"type": "gt", "params": [300]},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"type": "avg"}
            }
          ]
        }
      },
      {
        "id": 6,
        "title": "Orderflow: Book Gaps",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "rate(orderflow_book_gaps_detected_total[5m])",
            "legendFormat": "Gaps/min"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Gaps/min"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Analytics Query Latency (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(analytics_query_latency_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(analytics_query_latency_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
