# Bybit Analytics Worker — systemd unit
# Этап 4: изолированный analytics процесс
#
# Читает Parquet (read-only) + WAL tail catch-up
# Отвечает на запросы от api-server через UDS

[Unit]
Description=Bybit Analytics Worker
After=network.target bybit-maintenance.service
Wants=bybit-maintenance.service

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=bybit
Group=bybit
WorkingDirectory=/opt/bybit-chart
Environment="PATH=/opt/bybit-chart/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/opt/bybit-chart"

ExecStart=/opt/bybit-chart/.venv/bin/python workers/analytics_worker.py /opt/bybit-chart/data

TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=10

CPUWeight=500
IOWeight=300
MemoryMax=1G

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bybit-chart/data /opt/bybit-chart/logs /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bybit-analytics

[Install]
WantedBy=multi-user.target
