# Прямые зависимости проекта.
#
# Источник: Roadmap §4 «Рекомендуемый реальный технологический стек».
# Все зависимости фиксируются lock-файлом и SBOM (§4), release artifact
# содержит dependency lock (§20.1).
#
# Здесь перечислены ТОЛЬКО прямые зависимости с обоснованием. Файл общий
# для всех платформ (ADR-012): по платформам расходятся лишь разрешённый
# состав транзитивных зависимостей и хеши колёс.
#
# Полный граф с точными версиями, SHA-256 и SBOM — по платформам:
#   deploy/dependencies/darwin-arm64/   РОЛЬ development (macOS, разработка)
#   deploy/dependencies/linux-<arch>/   РОЛЬ production  (НЕ СНЯТ, P1-S1-006)
#   deploy/dependencies/README.md       правила и команды
#
# Регенерация после любого изменения этого файла (на своей платформе):
#   python3 deploy/gen_dependency_artifacts.py
# Проверка соответствия окружения (offline, CI и целевой хост):
#   python3 deploy/verify_dependencies.py

# Pydantic — схемы событий контракта (Roadmap §4: «Backend | Python, FastAPI,
# Uvicorn, Pydantic»). Используется в contracts/schemas.py.
pydantic==2.11.1

# pytest — backend unit/property/invariant/fault tests (Roadmap §4:
# «Backend tests | pytest + Hypothesis»).
pytest==8.4.2

# pytest-asyncio — asyncio тесты для Bybit WebSocket client (Stage 2).
pytest-asyncio==0.25.2

# Hypothesis — property-based тесты storage core (Roadmap §4:
# «Backend tests | pytest + Hypothesis»). Используется в
# tests/contracts/test_property_frames_and_offsets.py и
# tests/fault/test_property_wal_truncation.py.
hypothesis==6.165.2

# PyArrow — Parquet writer/reader для долговременного хранения сегментов
# (Roadmap §6.4, §7). Используется в packages/storage/parquet_writer.py.
# ADR-004 фиксирует Decimal128 precision/scale для Arrow Schema.
pyarrow==19.0.0

# websockets — asyncio WebSocket client для Bybit public streams
# (Roadmap §5, §8). Используется в packages/bybit/ws_client.py.
# ADR-001 фиксирует выбор websockets над альтернативами.
websockets==14.1

# FastAPI — REST API framework для query endpoints (Roadmap §7, §4).
# Используется в packages/api/app.py для /api/v1/trades, /api/v1/symbols.
fastapi==0.115.6

# Uvicorn — ASGI server для FastAPI (Roadmap §4).
# Устанавливаем базовую версию; для production добавить uvloop, httptools отдельно.
uvicorn==0.32.1

# httpx — HTTP client для FastAPI TestClient (testing).
# Требуется starlette.testclient для интеграционных тестов API.
httpx==0.28.1

# Заявлено в Roadmap §4, но ещё не добавлено — каждая позиция вводится
# своей задачей вместо с использующим её кодом:
#   FastAPI, Uvicorn  api-gateway                   → Stage 4
#   grpcio, protobuf  IPC между процессами          → блок: ADR-002
#   httpx             Bybit REST API                 → Stage 3
#   psycopg/alembic   PostgreSQL migrations         → блок: ADR-005
